# =========================
# Open Plantbook (recommended)
# =========================
# Free per-species care thresholds. Generate credentials at
# https://open.plantbook.io -> "API keys" (OAuth2 client credentials).
OPB_CLIENT_ID=
OPB_CLIENT_SECRET=

# =========================
# Home Assistant (optional)
# =========================
# If set, live temperature + humidity from your thermostat drive the model.
# If unset/unreachable, Plantbot falls back to static indoor defaults.
HA_URL=http://localhost:8123
HA_TOKEN=
HA_TEMP_ENTITY=
HA_HUMIDITY_ENTITY=
# Optional lux sensor entity (usually not needed — set `light` per plant instead)
HA_LUX_ENTITY=
# Unit of the HA temperature entity: F (default) or C
HA_TEMP_UNIT=F

# =========================
# Location
# =========================
# Latitude (degrees) — used for day-length / season & dormancy calculations.
LATITUDE=40

# =========================
# Things
# =========================
# Name of the Things project where tasks will be created
THINGS_PROJECT_NAME=Plant Care

# =========================
# Remote plant server (optional)
# =========================
# If plant data lives on benedict, point the Mac at it. Blank = use local plants.yaml.
PLANTBOT_SERVER_URL=

# =========================
# Notion (legacy / optional)
# =========================
# Only needed if you run migrate_notion_to_yaml.py to import old plant data.
NOTION_TOKEN=
NOTION_DATABASE_ID=
