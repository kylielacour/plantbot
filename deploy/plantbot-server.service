[Unit]
Description=Plantbot editor + API server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=babe
WorkingDirectory=/home/babe/plantbot
EnvironmentFile=/home/babe/plantbot/.env
Environment=PLANTBOT_HOST=127.0.0.1
Environment=PLANTBOT_PORT=8770
ExecStart=/home/babe/plantbot/venv/bin/python plantserver.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
